# Copy this file to .env and choose your own passwords:   cp .env.example .env
# .env is listed in .gitignore, so your real passwords never go to GitHub.
# Use letters and digits only (the passwords are also used inside connection URLs).
# The Postgres passwords are applied only when the database volume is first created;
# after changing them, reset with `docker compose down -v` (deletes the warehouse).

# Warehouse database (also used by Airflow tasks and the Grafana data source)
POSTGRES_USER=dwh
POSTGRES_PASSWORD=change_me
POSTGRES_DB=pharma_dwh

# Airflow's own metadata database
AIRFLOW_DB_PASSWORD=change_me_too

# Grafana admin login (applied on Grafana's first start; later changes are made in the Grafana UI)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change_me_as_well

# Airflow web UI login: user "admin" with this password (set on every container start)
AIRFLOW_ADMIN_PASSWORD=change_me_four
