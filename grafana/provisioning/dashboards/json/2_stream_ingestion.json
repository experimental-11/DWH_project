  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Streaming ingestion.** IoT readings landing in `data/incoming_stream/` are replayed as micro-batches (2,000 rows, throttled to 5,000 events/s) into `staging.iot_readings`. Rows with a null reading ID or an unparsable timestamp are dropped to `audit.rejected_rows`."
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Overall throughput",
      "description": "Total records ingested / total stream seconds",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma_dwh"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma_dwh"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT round(sum(events_ingested) / NULLIF(sum(duration_s), 0), 0) AS \"events/s\" FROM audit.stream_metrics"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "wideLayout": true
      },
      "id": 2
    },
    {
      "type": "stat",
