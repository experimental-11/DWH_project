    {
      "type": "stat",
      "title": "Avg end-to-end latency",
      "description": "Mean of (commit timestamp - emit timestamp) per micro-batch",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma_dwh"
      },
      "gridPos": {
        "x": 12,
