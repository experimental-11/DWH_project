    {
      "type": "timeseries",
      "title": "Stream throughput (events/s)",
      "description": "Recommended chart: events per second for every micro-batch, to observe pipeline stability over the simulation run",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma_dwh"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma_dwh"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT window_end AS time, events_per_sec AS \"events/s\"\nFROM audit.stream_metrics WHERE $__timeFilter(window_end) ORDER BY 1"
        }
      ],
