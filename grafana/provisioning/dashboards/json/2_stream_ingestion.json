    {
      "type": "table",
      "title": "Stream runs",
      "description": "One row per stream file replayed",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma_dwh"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma_dwh"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT max(window_end) AS \"finished\", source_file AS file, count(*) AS \"micro-batches\",\n       sum(events_ingested) AS events, sum(malformed_count) AS malformed,\n       round(sum(events_ingested) / NULLIF(sum(duration_s), 0), 0) AS \"events/s\",\n       round(avg(avg_latency_s), 3) AS \"avg latency s\"\nFROM audit.stream_metrics GROUP BY run_id, source_file ORDER BY 1 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
