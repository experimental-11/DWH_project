          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT (SELECT count(*) FROM dwh.fact_sales) + (SELECT count(*) FROM dwh.fact_hospital_demand) AS rows"
