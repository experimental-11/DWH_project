        "justifyMode": "center",
        "wideLayout": true
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Validation pass rate",
      "description": "fact rows / (fact rows + rejected rows) x 100 for the two SDI facts",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma_dwh"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma_dwh"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH r AS (SELECT count(*) n FROM audit.rejected_rows\n           WHERE source_table IN ('staging.pharmacy_sales', 'staging.hospital_demand')),\n     f AS (SELECT (SELECT count(*) FROM dwh.fact_sales) + (SELECT count(*) FROM dwh.fact_hospital_demand) n)\nSELECT round(100.0 * f.n / NULLIF(f.n + r.n, 0), 2) AS \"pass rate\" FROM f, r"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#e66767",
                "value": null
              },
              {
                "color": "#c98500",
                "value": 95
              },
              {
                "color": "#0ca30c",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "wideLayout": true
      },
      "id": 4
    },
