      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma_dwh"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT medicine_id, version_no AS version, medicine_name, unit_cost, unit_price, valid_from, valid_to, is_current\nFROM dwh.dim_medicine\nWHERE medicine_id IN (SELECT medicine_id FROM dwh.dim_medicine GROUP BY 1 HAVING count(*) > 1)\nORDER BY medicine_id, version_no"
        }
