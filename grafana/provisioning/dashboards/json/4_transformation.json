          "rawSql": "SELECT executed_at AS time, step_name AS metric, duration_s AS value FROM audit.etl_step_log\nWHERE step_name IN ('03_staging_views.sql','10_load_dim_medicine.sql','11_load_dim_hospital.sql','12_load_dim_sales_misc.sql','20_load_fact_sales.sql','21_load_fact_hospital_demand.sql') AND $__timeFilter(executed_at) ORDER BY 1"
