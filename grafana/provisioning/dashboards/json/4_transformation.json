    {
      "type": "barchart",
      "title": "Rows per dimension & fact table",
      "description": "Current row count of every star-schema table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma_dwh"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
