  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Transformation & dimensional modeling.** Staging views rename + type-cast the raw TEXT columns; then `dim_medicine` (**SCD Type 2**, price history), `dim_hospital` / `dim_location` / `dim_channel` (**SCD Type 1**), `dim_sales_profile` (**junk dimension**: payment x discount x order size x customer segment x payer x promotion) and `dim_date` (**role-playing**: sale date / demand month) are loaded, followed by `fact_sales` (**transaction fact**, partitioned by month, degenerate dimension `mfg_batch_id`) and `fact_hospital_demand` (**periodic snapshot**, hospital x medicine x month). Loads are incremental (watermarks); rows failing validation go to `audit.rejected_rows`."
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Last transform duration",
      "description": "Sum of the transformation steps (views -> dims -> facts) in the latest load",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma_dwh"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma_dwh"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT round(sum(duration_s), 1) AS seconds FROM audit.etl_step_log\nWHERE run_id = (SELECT run_id FROM audit.etl_step_log WHERE step_name = '20_load_fact_sales.sql' ORDER BY executed_at DESC LIMIT 1) AND step_name IN ('03_staging_views.sql','10_load_dim_medicine.sql','11_load_dim_hospital.sql','12_load_dim_sales_misc.sql','20_load_fact_sales.sql','21_load_fact_hospital_demand.sql')"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "wideLayout": true
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Fact rows in the mart",
      "description": "fact_sales + fact_hospital_demand",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma_dwh"
