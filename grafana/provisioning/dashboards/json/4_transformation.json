      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma_dwh"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT source_table AS source, reject_reason AS rule, count(*) AS rows, max(rejected_at) AS \"last seen\"\nFROM audit.rejected_rows GROUP BY 1, 2 ORDER BY 3 DESC"
