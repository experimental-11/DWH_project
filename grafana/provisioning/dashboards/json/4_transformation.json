    {
      "type": "table",
      "title": "Rejected rows by validation rule",
      "description": "price > 0, valid dates, non-null SKU IDs, known medicine ... (empty = no rejects)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma_dwh"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
