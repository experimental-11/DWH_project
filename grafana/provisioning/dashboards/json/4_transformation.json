      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma_dwh"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT t AS \"table\", n AS rows FROM (\n  SELECT 'fact_sales' t, count(*) n FROM dwh.fact_sales UNION ALL\n  SELECT 'fact_hospital_demand', count(*) FROM dwh.fact_hospital_demand UNION ALL\n  SELECT 'dim_medicine', count(*) FROM dwh.dim_medicine UNION ALL\n  SELECT 'dim_location', count(*) FROM dwh.dim_location UNION ALL\n  SELECT 'dim_sales_profile (junk)', count(*) FROM dwh.dim_sales_profile UNION ALL\n  SELECT 'dim_hospital', count(*) FROM dwh.dim_hospital UNION ALL\n  SELECT 'dim_channel', count(*) FROM dwh.dim_channel) x ORDER BY n DESC"
        }
      ],
      "fieldConfig": {
