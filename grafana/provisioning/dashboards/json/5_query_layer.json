      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma_dwh"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT city, medicine_name AS medicine, packs_sold AS \"packs sold\", share_of_city_pct AS \"% of city's packs\"\nFROM dwh.q1_top_medicine_per_city($year, '$disease')"
        }
