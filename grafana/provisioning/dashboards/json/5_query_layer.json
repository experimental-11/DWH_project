    {
      "type": "table",
      "title": "Q1 · Most common $disease medicine per city ($year)",
      "description": "fact_sales → dim_date (year), dim_medicine (disease category), dim_location (city); ranked by packs sold",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma_dwh"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 12
