      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma_dwh"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT state, sum(requested_packs) AS \"requested packs\"\nFROM dwh.q3_controlled_requests_by_state('$quarter') GROUP BY state ORDER BY 2 DESC"
