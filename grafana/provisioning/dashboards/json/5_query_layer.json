    {
      "type": "barchart",
      "title": "Q2 · Net sales by therapeutic class: Physical vs E-commerce ($q2_year, top 15)",
      "description": "fact_sales → dim_date, dim_channel, dim_medicine (therapeutic class)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma_dwh"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma_dwh"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT therapeutic_class AS class,\n       sum(net_sales_usd) FILTER (WHERE channel = 'Physical Pharmacy') AS \"Physical Pharmacy\",\n       sum(net_sales_usd) FILTER (WHERE channel = 'E-commerce')        AS \"E-commerce\"\nFROM dwh.q2_channel_by_therapeutic_class($q2_year)\nGROUP BY therapeutic_class ORDER BY 2 DESC NULLS LAST LIMIT 15"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
