    {
      "type": "barchart",
      "title": "Q3 · Controlled-medicine packs requested per state ($quarter)",
      "description": "fact_hospital_demand → dim_date (role: demand month), dim_medicine (controlled flag), dim_hospital (state)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma_dwh"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 12,
        "h": 10
